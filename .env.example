# 飞书企业自建应用：开启机器人能力，将机器人名称设置为「消息总结」。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 填写支持 Anthropic Messages 的服务地址、密钥和实际模型名称。
# 支持 https://host、https://host/v1、https://host/v1/messages 三种形式。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# 固定仅响应群内 @；旧配置 all 也会按 mention 处理。
TRIGGER_MODE=mention
# 可选；留空时启动会自动查询。填写时必须是当前机器人 open_id，不能填 App ID。
BOT_OPEN_ID=
# 留空监听机器人所在的全部群；多个群 ID 以英文逗号分隔。
ALLOWED_CHAT_IDS=

# 输入字符预算与每条消息的字符上限；超过时提示拆分，不静默截断所选记录。
MAX_INPUT_CHARS=24000
MAX_MESSAGE_CHARS=2000
DISPLAY_TIMEZONE=Asia/Shanghai

# 相对路径以本项目目录为基准；数据库保存待处理消息和去重状态。
STATE_DB_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
